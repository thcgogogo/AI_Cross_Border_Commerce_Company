# Secrets — NEVER commit your real key
.env

# Uploaded files, per-job memory, and per-run generated artifacts
# (outputs/ files committed before this rule stay tracked — git ignores the
# pattern for already-tracked paths)
uploads/
memory_store/
outputs/

# Persistent company-brain SQLite database
data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/
