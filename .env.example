# Copy this file to ".env" and paste your real key below.
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# Optional: change the port the website runs on (default 8000)
PORT=8000

# ---------------------------------------------------------------------------
# OPTIONAL — other model providers (multi-provider support)
# ---------------------------------------------------------------------------
# The team can also run on OpenAI, Google, xAI, DeepSeek, Qwen, MiniMax, Kimi
# (Moonshot), Tencent (Hunyuan), Xiaomi (MiMo), and ByteDance (Seedream). Each
# model runs through one OpenAI-compatible adapter. They stay DORMANT until you
# add the matching key below: uncomment a line (remove the leading "#") and paste
# your key. Models without a key still show in the catalog/store, but a run,
# Fusion, or gateway call that needs them returns a clear "add KEY to .env"
# message — nothing is faked. Restart the app after editing.
#
# OPENAI_API_KEY=sk-paste-your-openai-key
# GEMINI_API_KEY=paste-your-google-ai-studio-key
# XAI_API_KEY=xai-paste-your-grok-key
# DEEPSEEK_API_KEY=sk-paste-your-deepseek-key
# DASHSCOPE_API_KEY=sk-paste-your-alibaba-qwen-key
# MINIMAX_API_KEY=paste-your-minimax-key
# MOONSHOT_API_KEY=sk-paste-your-moonshot-kimi-key
# HUNYUAN_API_KEY=paste-your-tencent-hunyuan-key
# XIAOMI_API_KEY=paste-your-xiaomi-mimo-key
# ARK_API_KEY=paste-your-bytedance-ark-key       # Seedream / Volcengine Ark

# ---------------------------------------------------------------------------
# OPTIONAL — email delivery for scheduled reports (定时任务 → 邮件)
# ---------------------------------------------------------------------------
# Scheduled "周报" can be emailed out as a branded PDF. This stays DORMANT until
# you set SMTP_HOST: with it unset, scheduled runs still complete — they just skip
# the email step. Uncomment and fill these in, then restart the app. The values
# shown are a typical submission setup (port 587 + STARTTLS); use whatever your
# provider documents. Credentials are NEVER written to logs or the database.
#
# SMTP_HOST=smtp.your-provider.com     # required to turn email on (e.g. smtp.qq.com)
# SMTP_PORT=587                        # default 25 if omitted; 587 = STARTTLS, 465 = SSL
# SMTP_USER=you@yourcompany.com        # login user (auth is skipped if left blank)
# SMTP_PASS=your-smtp-password-or-app-token
# SMTP_FROM=you@yourcompany.com        # "From" address; defaults to SMTP_USER
# SMTP_STARTTLS=1                      # 1 for STARTTLS (port 587, most providers)
# SMTP_SSL=1                           # 1 for implicit TLS instead (port 465)
#
# The OTHER delivery channel — 企业微信群机器人 — is configured per-company INSIDE
# the app (Menu → 企业大脑), not here, since each company uses its own webhook URL.

# ---------------------------------------------------------------------------
# OPTIONAL — verification trail & feedback (the "每个数字可溯源" features)
# ---------------------------------------------------------------------------
# ADMIN_EMAILS: who can open the founder feedback dashboard at /admin/feedback
# (every 👍/👎 across all companies, exportable as CSV). Comma/space separated.
# Leave unset and NOBODY is an admin — the dashboard stays locked.
# ADMIN_EMAILS=you@yourcompany.com, cofounder@yourcompany.com
#
# PRODUCT_DOMAIN: your product's domain. When set, it is appended to the report
# footer ("由 … AI 团队生成 · 每个数字可溯源 · yourdomain.com"). Omitted if unset.
# PRODUCT_DOMAIN=yourdomain.com

# ===========================================================================
# PRODUCTION DEPLOYMENT (Phase 7) — only needed for `docker compose` / a server.
# Local dev needs NOTHING below: with these unset the app uses a local SQLite
# file and an auto-generated dev session key, exactly as before. See docs/ops.md.
# ===========================================================================

# --- Environment -----------------------------------------------------------
# APP_ENV: "development" (default), "staging", or "production". In production the
# app REFUSES to boot without a real SECRET_KEY (see below) — no silent dev secret.
# APP_ENV=production

# SECRET_KEY: signs the login session cookie. MANDATORY in production. Generate one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# (Dev only: if unset, a key is generated once and saved to memory_store/.flask_secret.)
# SECRET_KEY=replace-with-a-long-random-hex-string

# --- Database --------------------------------------------------------------
# DATABASE_URL: the SQLAlchemy URL. UNSET → local SQLite at data/company_brain.db
# (zero-config dev). For Postgres use:
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
#
# IMPORTANT: under docker compose you normally DON'T set DATABASE_URL — compose
# builds it automatically from the POSTGRES_* vars below and points it at the
# `postgres` service. Only set it here to target an external/managed Postgres.
# DATABASE_URL=postgresql+psycopg2://company:CHANGE_ME@postgres:5432/company

# POSTGRES_* : consumed by the postgres container AND used by compose to compose
# DATABASE_URL. POSTGRES_PASSWORD is REQUIRED to start the stack — set a strong one.
POSTGRES_DB=company
POSTGRES_USER=company
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password

# --- Processes -------------------------------------------------------------
# RUN_SCHEDULER: 1 (default) runs the 定时任务 scheduler IN the web process — right
# for single-process / local `python app.py`. Under docker compose it is set to 0
# for the web app, because the dedicated `scheduler` container owns cron. Leave it
# unset locally.
# RUN_SCHEDULER=0
#
# RUN_MIGRATIONS: set by the container entrypoint (1 for the app = the single
# migrator, 0 for the scheduler). You normally never set this by hand.

# --- Monitoring ------------------------------------------------------------
# SENTRY_DSN: turn on error tracking by pasting your Sentry DSN. Unset = disabled
# (no network calls). Request bodies / cookies are never sent.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Backups ---------------------------------------------------------------
# BACKUP_REMOTE: an rclone remote+path for offsite backup upload (Alibaba OSS /
# Tencent COS / any S3-compatible bucket). Unset = local-only backups. The host
# must have rclone installed + configured. See docs/ops.md §3.
# BACKUP_REMOTE=oss:my-bucket/company-agent

# --- nginx -----------------------------------------------------------------
# HTTP_PORT: the host port nginx publishes (default 80). Use e.g. 8080 if 80 is taken.
# HTTP_PORT=80

# ===========================================================================
# SECURITY & ABUSE HARDENING (Phase 8) — all OPTIONAL for local dev.
# With everything below unset: SMS codes print to the console, files are stored
# in plaintext, rate limits use in-process memory, and spend caps are disabled —
# so `python app.py` still runs with zero extra config. Turn each on for prod.
# ===========================================================================

# --- Phone (SMS) verification ----------------------------------------------
# Signup + password reset use an SMS code (6 digits, 5-min expiry). With NO
# provider configured the ConsoleSmsProvider prints the code to the app log
# (fine for dev/tests). For real delivery in China, set the Aliyun SMS keys:
# SMS_PROVIDER=aliyun                      # or "console" (default when keys absent)
# ALIYUN_SMS_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_SMS_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_SMS_SIGN_NAME=你的短信签名
# ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789
# ALIYUN_SMS_REGION=cn-hangzhou
#
# PHONE_VERIFICATION=1   # default on; set 0 to drop the SMS step (not recommended)

# --- Encryption at rest (Fernet) -------------------------------------------
# Encrypt uploaded files + generated report PDFs on disk. UNSET = plaintext (dev).
# Set one or more keys (comma-separated, NEWEST first) to rotate without downtime:
# old files still decrypt with an older key, new writes use the first.
#   Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEYS=newest-key-here,previous-key-here

# --- Platform spend circuit breaker (CRITICAL in prod) ---------------------
# Rolling ¥ WE spend on upstream provider keys. 0 (default) = no cap. When a cap
# is exceeded the app refuses new runs with "系统繁忙，请稍后再试", alerts the admin
# (email to ADMIN_EMAILS + ADMIN_ALERT_WEBHOOK), and stays tripped until an admin
# resets it at /admin/circuit-breaker.
# PLATFORM_HOURLY_CAP_YUAN=200
# PLATFORM_DAILY_CAP_YUAN=2000
# ACCOUNT_DAILY_CAP_YUAN=200       # per-account/day ceiling (default 200; per-row override exists)
# ADMIN_ALERT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...

# --- Rate limiting ----------------------------------------------------------
# Auth endpoints are limited per IP; run-start per account. Defaults are in-process
# memory (correct for ONE process). For multi-worker gunicorn, point at a shared
# backend so the counters are global:
# RATELIMIT_STORAGE_URI=redis://redis:6379
# AUTH_RATE_LIMIT=5 per minute
# RUN_RATE_LIMIT=10 per hour
# RATELIMIT_ENABLED=1              # set 0 to disable rate limiting entirely

# ===========================================================================
# PAYMENTS, SUBSCRIPTIONS & FAPIAO (Phase 9) — all OPTIONAL for local dev.
# With NO provider configured the built-in Mock provider takes over: orders
# "pay" at a local fake cashier (/pay/mock/...) with HMAC-signed notifies, so
# the whole money path works locally with zero config and zero real money.
# The moment a real provider is configured, mock goes dead automatically.
# ===========================================================================

# APP_BASE_URL: the public URL of this deployment — used to build the payment
# notify_url callbacks (must be reachable FROM Alipay/WeChat servers) and the
# pay links in renewal notices.
# APP_BASE_URL=https://your-domain.example.com

# --- Alipay (open platform, RSA2) -------------------------------------------
# Keys accept full PEM (with \n escapes) or the bare base64 body as the Alipay
# console hands it out. ALIPAY_PUBLIC_KEY is ALIPAY's key (for verifying
# notifies), NOT your application public key.
# ALIPAY_APP_ID=2021000000000000
# ALIPAY_APP_PRIVATE_KEY=MIIEv...your-application-private-key...
# ALIPAY_PUBLIC_KEY=MIIBIj...alipay-public-key...
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# --- WeChat Pay (APIv3, native QR) ------------------------------------------
# WECHATPAY_MCHID=1900000000
# WECHATPAY_APPID=wx0000000000000000
# WECHATPAY_API_V3_KEY=your-32-char-apiv3-key
# WECHATPAY_SERIAL_NO=your-merchant-cert-serial
# WECHATPAY_PRIVATE_KEY=MIIEv...merchant-private-key...
# WECHATPAY_PLATFORM_CERT=MIID...wechatpay-platform-certificate...

# --- Subscriptions -----------------------------------------------------------
# Renewal is USER-CONFIRMED (China norm): an order + pay-link notice at T-3d,
# never an auto-charge. Grace after expiry, then past_due (locked except data
# export), then canceled. Plan prices/quotas live in agent_team/config.py PLANS.
# SUB_RENEWAL_LEAD_DAYS=3
# SUB_GRACE_DAYS=3
# SUB_PAST_DUE_CANCEL_DAYS=30

# --- Reconciliation -----------------------------------------------------------
# Nightly (03:30 Beijing) the scheduler compares provider bill CSVs dropped in
# BILLS_DIR (<provider>-<YYYY-MM-DD>.csv) against the orders table; mismatches
# alert the admins and show on /admin/reconciliation.
# BILLS_DIR=/srv/company-agent/data/bills

# PAYMENT_MOCK_SECRET: HMAC secret for the dev Mock provider's signed notifies.
# Only relevant while no real provider is configured (mock is auto-disabled then).
# PAYMENT_MOCK_SECRET=change-me-for-shared-dev-boxes

# ============================================================================
# ONBOARDING, SUPPORT & OPS DASHBOARD (Phase 10) — all optional
# ============================================================================
# The 联系支持 popup (the floating button in the app + on /help pages) shows a
# 企业微信 group QR and a mailto link. Both degrade gracefully when unset: the
# QR shows a "待配置" placeholder, and the mailto falls back to the FIRST
# ADMIN_EMAILS entry (hidden entirely if there are no admins). Messages typed
# into the popup are ALWAYS logged to the support_requests table either way.
# SUPPORT_EMAIL=support@your-domain.com
# SUPPORT_WECHAT_QR_URL=https://your-cdn/wechat-support-qr.png
#
# No other Phase 10 knobs: the onboarding wizard, /help docs (docs/help/*.md),
# /changelog (CHANGELOG.md), the /admin ops dashboard (gated by ADMIN_EMAILS),
# and the lifecycle emails (welcome / day-3 nudge at 10:00 Beijing / receipts,
# sent through the SMTP settings above) all work with zero extra config.
